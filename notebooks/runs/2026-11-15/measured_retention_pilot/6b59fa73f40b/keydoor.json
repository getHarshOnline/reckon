    "episodes_per_arm": 1,
    "reference_policy": "fifo",
    "sampling": {
      "test_type": "permutation",
      "n_trials": 4,
      "n_permutations": 256,
      "alpha": 0.05,
      "delta_threshold": 0.05,
      "fdr_method": "bonferroni",
      "adaptive_sampling": false,
      "early_stopping": true,
      "min_trials": 2,
      "max_trials": 4,
      "seed": 1000000
    }
  }
}
