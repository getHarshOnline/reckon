{
  "task": "keydoor",
  "environment": {},
  "budget": {
    "max_slots": 1
  },
  "retention_policy": "fifo",
  "experiment": {
    "num_episodes": 3,
    "seed": 100,
    "reset_memory": false,
    "learn_utility": true
  },
