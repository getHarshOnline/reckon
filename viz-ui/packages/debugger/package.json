{
  "name": "@rtepl/reckon-debugger",
  "version": "0.1.0",
  "description": "Reckon's debugger: a browser interface for inspecting a run's records, events and credit",
  "author": "Harsh Joshi <hi@causality.in>",
  "license": "Apache-2.0",
  "homepage": "https://causality.in/reckon",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@rtepl/reckon-components": "workspace:*",
    "@xyflow/react": "^12.4.0",
    "plotly.js-dist-min": "^2.35.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-plotly.js": "^2.6.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-plotly.js": "^2.6.3",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/getHarshOnline/reckon",
    "directory": "viz-ui/packages/debugger"
  },
  "keywords": [
    "memory",
    "debugger",
    "visualization",
    "timeline",
    "causal",
    "agent"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
